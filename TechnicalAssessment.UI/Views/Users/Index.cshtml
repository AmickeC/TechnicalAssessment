@{
    ViewData["Title"] = "User Management";
}

@model List<TechnicalAssessment.UI.Models.UserDto>

@{
    int totalUsers = ViewBag.TotalUsers; // matches what the controller sets
    var groups = ViewBag.Groups as List<TechnicalAssessment.UI.Models.GroupDto> 
                 ?? new List<TechnicalAssessment.UI.Models.GroupDto>();
}

<h2>@totalUsers Users</h2>

@if (groups.Any())
{
    <p class="text-muted mb-3">
        <strong>Users per group:</strong>
        @foreach (var group in groups)
        {
            <span>@group.Name: @group.UserCount</span>@(group != groups.Last() ? ", " : "")
        }
    </p>
}

<a asp-action="Create" class="btn btn-success mb-3">Add User</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Groups</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Groups != null && user.Groups.Any())
                        {
                            @string.Join(", ", user.Groups.Select(g => g.Name))
                        }
                        else
                        {
                            <em>No groups</em>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Edit</a>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to delete this user?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No users found</td>
            </tr>
        }
    </tbody>
</table>

<div id="resultMessage" class="mt-3"></div>
