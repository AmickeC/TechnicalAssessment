@model TechnicalAssessment.UI.Models.UserCreateModel

@{
    ViewData["Title"] = "Create User";
    var groups = ViewBag.Groups as List<TechnicalAssessment.UI.Models.GroupDto> ?? new List<TechnicalAssessment.UI.Models.GroupDto>();
}

<h2>Create User</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Groups</label>
        <select asp-for="GroupIds" class="form-select" multiple>
            @foreach (var group in groups)
            {
                // Default to user
                <option value="@group.Id" selected="@(group.Name == "User")">
                    @group.Name
                </option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-success">Create User</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
