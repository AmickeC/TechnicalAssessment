@model TechnicalAssessment.UI.Models.UserEditModel

@{
    ViewData["Title"] = "Edit User";
    var groups = ViewBag.Groups as List<TechnicalAssessment.UI.Models.GroupDto> ?? new List<TechnicalAssessment.UI.Models.GroupDto>();
}

<h2>Edit User</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Groups</label>
        <select asp-for="GroupIds" class="form-select" multiple>
            @foreach (var group in groups)
            {
                <option value="@group.Id" 
                        selected="@(Model.GroupIds.Contains(group.Id))">
                    @group.Name
                </option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-warning">Update User</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
